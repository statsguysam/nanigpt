   "source": [
    "## Step 4 — Updated Gradio Blocks\n",
    "\n",
    "This replaces your existing Gradio app cell. It's the same as before but the second column now has both 'Type' and 'Speak' inputs side by side via a sub-tab.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import gradio as gr\n",
    "\n",
    "with gr.Blocks(title='NaniGPT', theme=gr.themes.Soft(primary_hue='indigo', neutral_hue='slate')) as demo:\n",
    "    gr.Markdown(\n",
    "        '# 🌸 NaniGPT\\n'\n",
    "        '*A private companion for adult children caring for aging parents.*  '\n",
    "        'All AI runs on the phone. No cloud. No data ever leaves the device.'\n",
    "    )\n",
    "\n",
    "    with gr.Tabs():\n",
    "\n",
    "        # ===== TAB 1: DAILY CHECK-IN =====\n",
    "        with gr.Tab('Daily check-in'):\n",
    "            with gr.Row():\n",
    "                # ---- Column A: Pill organizer photo ----\n",
    "                with gr.Column():\n",
    "                    gr.Markdown('### 📷 Photograph the pill organizer')\n",
    "                    pill_img = gr.Image(type='pil', label=None, height=300)\n",
    "                    pill_btn = gr.Button('Check the pills', variant='primary', size='lg')\n",
    "                    pill_changes = gr.Markdown()\n",
    "                    pill_logged  = gr.Markdown()\n",
    "                    with gr.Accordion('Show what NaniGPT saw (technical view)', open=False):\n",
    "                        pill_today_json = gr.Code(label='Per-slot classification (JSON)', language='json', lines=14)\n",
    "\n",
    "                # ---- Column B: Journal (Type / Speak) ----\n",
    "                with gr.Column():\n",
    "                    gr.Markdown(\n",
    "                        '### 💬 Tell NaniGPT what happened\\n'\n",
    "                        \"Type or speak — about Mom's day, anything you noticed, or a question for the doctor.\"\n",
    "                    )\n",
    "                    with gr.Tabs():\n",
    "                        # ----- Type sub-tab -----\n",
    "                        with gr.Tab('⌨️ Type'):\n",
    "                            journal_input = gr.Textbox(\n",
    "                                label=None,\n",
    "                                placeholder=\"e.g. 'Mom slept 3 hours, refused breakfast, asked where Dad is three times.'\",\n",
    "                                lines=5,\n",
    "                            )\n",
    "                            journal_btn = gr.Button('Log it', variant='primary', size='lg')\n",
    "                            journal_reply = gr.Markdown()\n",
    "                            with gr.Accordion('Show tool calls (technical view)', open=False):\n",
    "                                journal_calls = gr.Textbox(label='Calls executed', lines=4)\n",
    "                                journal_raw   = gr.Textbox(label=\"Model's raw output\", lines=6)\n",
    "                            journal_btn.click(run_journal, inputs=journal_input,\n",
    "                                              outputs=[journal_reply, journal_calls, journal_raw])\n",
    "\n",
    "                        # ----- Speak sub-tab -----\n",
    "                        with gr.Tab('🎙️ Speak'):\n",
    "                            voice_input = gr.Audio(\n",
    "                                sources=['microphone', 'upload'],\n",
    "                                type='filepath',\n",
    "                                label='Record or upload a voice note',\n",
    "                            )\n",
    "                            voice_btn = gr.Button('Transcribe and log', variant='primary', size='lg')\n",
    "                            voice_transcript = gr.Textbox(label=\"What NaniGPT heard\", lines=3)\n",
    "                            voice_reply = gr.Markdown()\n",
    "                            with gr.Accordion('Show tool calls (technical view)', open=False):\n",
    "                                voice_calls = gr.Textbox(label='Calls executed', lines=4)\n",
    "                                voice_raw   = gr.Textbox(label=\"Model's raw output\", lines=6)\n",
    "                            voice_btn.click(handle_voice_journal, inputs=voice_input,\n",
    "                                            outputs=[voice_transcript, voice_reply, voice_calls, voice_raw])\n",
    "\n",
    "            pill_btn.click(handle_pill_photo, inputs=pill_img,\n",
    "                           outputs=[pill_changes, pill_logged, pill_today_json])\n",
    "\n",
    "        # ===== TAB 2: TODAY'S LOG =====\n",
    "        with gr.Tab(\"Today's log\"):\n",
    "            log_view = gr.Markdown()\n",
    "            refresh = gr.Button('🔄 Refresh', size='sm')\n",
    "            refresh.click(render_log_md, outputs=log_view)\n",
    "            demo.load(render_log_md, outputs=log_view)\n",
    "\n",
    "        # ===== TAB 3: DOCTOR VISIT PREP =====\n",
    "        with gr.Tab('Doctor visit prep'):\n",
    "            gr.Markdown('### Generate the report for the next appointment')\n",
    "            with gr.Row():\n",
    "                patient_in = gr.Textbox(label='Patient name', value='Mom', scale=2)\n",
    "                days_in    = gr.Number(label='Days to include', value=30, precision=0, scale=1)\n",
    "                report_btn = gr.Button('Generate report', variant='primary', scale=1)\n",
    "            report_view = gr.Markdown()\n",
    "            report_btn.click(make_doctor_report, inputs=[patient_in, days_in], outputs=report_view)\n",
    "\n",
    "demo.launch(share=True)"
   ]
  },
