    "_LOG.clear()\n",
    "raw, calls = run_agent(\n",
    "    \"Mom took her morning Tuesday pills today, finally. Tell my brother — he was worried last night.\"\n",
    ")\n",
    "print('\\nFinal log:', _LOG)"
   ]
