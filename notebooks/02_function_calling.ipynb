   "source": [
    "# NaniGPT — Day 2/3: Function calling end-to-end\n",
    "\n",
    "**Goal:** prove Gemma 4 E4B can take natural-language caregiver input and dispatch the right tool calls (log pill change, log incident, add to doctor visit, notify sibling, generate report).\n",
    "\n",
    "**Pre-req:** the `model` and `tokenizer` from `01_setup_and_inference.ipynb` must already be loaded.\n",
    "\n",
    "**Important parsing note:** Gemma 4 emits tool calls in its OWN format `call:name{key:val,key:val}`, NOT standard JSON. We use a signature-aware parser that knows each tool's argument names so it can correctly split values that contain commas (e.g., 'where Dad is, who has been gone for 4 years').\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 1 — Define the tools inline (mirrors `app/tools.py`)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from typing import Literal\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "_LOG = []\n",
    "def _now_iso(): return datetime.now(timezone.utc).isoformat(timespec='seconds')\n",
    "def _append(entry):\n",
    "    record = {'ts': _now_iso(), **entry}\n",
    "    _LOG.append(record)\n",
    "    return record\n",
    "\n",
    "def log_pill_change(day: Literal['MON','TUE','WED','THU','FRI','SAT','SUN'],\n",
    "                    ampm: Literal['AM','PM'],\n",
    "                    change: Literal['taken','refilled','missed'],\n",
    "                    note: str = '') -> dict:\n",
    "    \"\"\"Log a pill organizer state change detected by the morning photo diff.\n",
    "    Args: day, ampm, change (taken/refilled/missed), optional note.\"\"\"\n",
    "    return _append({'category':'medication','day':day,'ampm':ampm,'change':change,'note':note})\n",
    "\n",
    "def log_incident(category: Literal['fall','bruise','behavior','appetite','sleep','wandering','other'],\n",
    "                 detail: str,\n",
    "                 severity: Literal['low','medium','high'],\n",
    "                 photo_attached: bool = False) -> dict:\n",
    "    \"\"\"Log an observation about the parent.\n",
    "    Use low for trends, medium for next visit, high for same-day clinician call.\"\"\"\n",
    "    return _append({'category':'incident','incident_type':category,'detail':detail,'severity':severity,'photo_attached':photo_attached})\n",
    "\n",
    "def add_to_doctor_visit(item: str,\n",
    "                        priority: Literal['fyi','important','urgent'] = 'fyi') -> dict:\n",
    "    \"\"\"Queue an item for the next doctor visit.\"\"\"\n",
    "    return _append({'category':'doctor_agenda','item':item,'priority':priority})\n",
    "\n",
    "def notify_sibling(message: str,\n",
    "                   urgency: Literal['info','soon','now'] = 'info') -> dict:\n",
    "    \"\"\"Send a notification to family caregivers.\"\"\"\n",
    "    return _append({'category':'sibling_notify','message':message,'urgency':urgency})\n",
    "\n",
    "def generate_doctor_pdf(patient_name: str, days: int = 30) -> dict:\n",
    "    \"\"\"Compile the last N days of log entries into a printable PDF.\"\"\"\n",
    "    return {'patient': patient_name, 'days': days, 'entries_count': len(_LOG), 'path': f'/data/exports/{patient_name.replace(\" \",\"_\")}_{days}d.pdf'}\n",
    "\n",
    "TOOLS = [log_pill_change, log_incident, add_to_doctor_visit, notify_sibling, generate_doctor_pdf]\n",
    "TOOL_MAP = {t.__name__: t for t in TOOLS}\n",
    "print('Tools defined:', list(TOOL_MAP))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 2 — Signature-aware parser for Gemma 4's tool-call format\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import re, inspect, torch\n",
    "from transformers import TextStreamer\n",
    "\n",
    "AGENT_SYSTEM = '''You are NaniGPT, a private companion for adult children caring for aging parents with dementia. When the caregiver tells you something, decide whether to call one or more tools to log it, queue it for the doctor, or notify other family. Use tools liberally — that's the point. Reply briefly after the tool calls to confirm what you did.'''\n",
    "\n",
    "def parse_gemma_tool_calls(text, tool_map):\n",
    "    \"\"\"Parse Gemma 4's native call:name{key:val,key:val} format. Uses each tool's\n",
    "    signature to locate key boundaries — handles commas inside string values.\"\"\"\n",
    "    calls = []\n",
    "    for m in re.finditer(r'call:(\\w+)\\s*\\{(.*?)\\}', text, re.DOTALL):\n",
    "        name, body = m.group(1), m.group(2)\n",
    "        if name not in tool_map:\n",
    "            continue\n",
    "        sig = inspect.signature(tool_map[name])\n",
    "        keys = list(sig.parameters.keys())\n",
    "\n",
    "        positions = []\n",
    "        for k in keys:\n",
    "            for km in re.finditer(rf'\\b{re.escape(k)}\\s*:', body):\n",
    "                positions.append((km.start(), k, km.end()))\n",
    "        positions.sort()\n",
    "\n",
    "        args = {}\n",
    "        for i, (start, key, val_start) in enumerate(positions):\n",
    "            val_end = positions[i + 1][0] if i + 1 < len(positions) else len(body)\n",
    "            val = body[val_start:val_end].rstrip(',').strip()\n",
    "            ann = sig.parameters[key].annotation\n",
    "            if ann is bool or val.lower() in ('true', 'false'):\n",
    "                args[key] = val.lower() == 'true'\n",
    "            elif ann is int:\n",
    "                try: args[key] = int(val)\n",
    "                except: args[key] = val\n",
    "            else:\n",
    "                args[key] = val\n",
    "        calls.append((name, args))\n",
    "    return calls\n",
    "\n",
    "\n",
    "def run_agent(user_message: str, verbose: bool = True):\n",
    "    messages = [\n",
    "        {'role': 'system', 'content': [{'type': 'text', 'text': AGENT_SYSTEM}]},\n",
    "        {'role': 'user',   'content': [{'type': 'text', 'text': user_message}]},\n",
    "    ]\n",
    "    inputs = tokenizer.apply_chat_template(\n",
    "        messages, tools=TOOLS, add_generation_prompt=True,\n",
    "        tokenize=True, return_dict=True, return_tensors='pt',\n",
    "    ).to(model.device)\n",
    "\n",
    "    with torch.no_grad():\n",
    "        out = model.generate(**inputs, max_new_tokens=600, temperature=0.3, top_p=0.9, do_sample=False)\n",
    "\n",
    "    raw = tokenizer.decode(out[0][inputs['input_ids'].shape[1]:], skip_special_tokens=True)\n",
    "    if verbose:\n",
    "        print('--- raw model output ---')\n",
    "        print(raw)\n",
    "        print('------------------------')\n",
    "\n",
    "    calls = parse_gemma_tool_calls(raw, TOOL_MAP)\n",
    "    results = []\n",
    "    for name, args in calls:\n",
    "        try:\n",
    "            r = TOOL_MAP[name](**args)\n",
    "            results.append({'tool': name, 'args': args, 'result': r})\n",
    "            if verbose: print(f'CALLED {name}({args})')\n",
    "        except Exception as e:\n",
    "            results.append({'tool': name, 'args': args, 'error': str(e)})\n",
    "            if verbose: print(f'ERROR  {name}: {e}')\n",
    "    return raw, results"
   ]
  },
  {
   "cell_type": "markdown",
